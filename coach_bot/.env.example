# OpenRouter (coach bot + strava_erg_hr_plot.py weekly plan)
# Copy to coach_bot/.env and fill in your key:
#   cp coach_bot/.env.example coach_bot/.env
#
# API keys: https://openrouter.ai/keys
# Auto Router: https://openrouter.ai/docs/guides/routing/routers/auto-router

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Default: OpenRouter Auto Router picks a model per prompt.
# Pin a specific slug to bypass auto selection.
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_VISION_MODEL=openrouter/auto
OPENROUTER_STRUCTURED_MODEL=openrouter/auto
# Cost band for auto routing: low, medium, high, xhigh, max
# OPENROUTER_COST_TIER=low

# Optional overrides (defaults are fine for most setups)
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_APP_TITLE=rowing-coach-bot
