# OpenRouter (coach bot + strava_erg_hr_plot.py weekly plan)
# Copy to coach_bot/.env and fill in your key:
#   cp coach_bot/.env.example coach_bot/.env
#
# API keys: https://openrouter.ai/keys
# Models:    https://openrouter.ai/models

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Prose LLM: adherence, goal tracking, coach chat, plan fallback.
# If anthropic/claude-3.5-haiku returns HTTP 404, use openai/gpt-4o-mini instead.
OPENROUTER_MODEL=openai/gpt-4o-mini
# High-performance multimodal model: erg screenshots route here (no local OCR).
# e.g. google/gemini-2.5-flash, anthropic/claude-3.5-sonnet
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# Weekly plan json_schema — must support structured_outputs on OpenRouter.
# See https://openrouter.ai/models?supported_parameters=structured_outputs
OPENROUTER_STRUCTURED_MODEL=openai/gpt-4o-mini

# Optional overrides (defaults are fine for most setups)
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_APP_TITLE=rowing-coach-bot
